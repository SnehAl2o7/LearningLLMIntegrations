# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-generate-with-django-secret-key-generator
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# NVIDIA API Key for Embeddings (required for recommendations)
# Get your key from: https://build.nvidia.com/
NVIDIA_API_KEY=your-nvidia-api-key-here

# Database (optional - defaults to SQLite)
# DATABASE_URL=postgres://user:pass@localhost:5432/dbname

# CORS (optional - defaults to localhost:5173)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173